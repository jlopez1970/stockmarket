//@version=6
// ════════════════════════════════════════════════════════════════════════════
// Spike Alerts Log  v1.00  (Oct 2026)
// From the "non related correlations" research (2-min bars, Sep 2024 – Sep 2026)
//
//  1) QQQ VOLUME SPIKE  → SOXL same direction / VIXY opposite, hold 2 min
//     QQQ 2-min volume >= 3.67x its 20-day median for that time slot AND a
//     >= 2 sigma move, no other high-volume QQQ bar in the previous 10 min.
//     Backtest after 1-cent cost: SOXL +6.8 bps (56%), VIXY +5.7 bps (58%).
//
//  2) EUR/USD VOLUME SPIKE → FADE SPY / QQQ / SOXL (VIXY same as EUR), hold 60 min
//     EUR/USD tick volume >= 1.83x its 20-day slot median AND a >= 2 sigma move,
//     first in 10 min. One trade at a time. Backtest: QQQ +9.5 / +7.3 bps,
//     SOXL +44 / +73 bps per trade (2024-25 / 2026), win rate only ~50-55%.
//
// Use on a 2-minute chart of SOXL, VIXY, SPY or QQQ (regular hours).
// Every closed trade is written to the table, to Pine Logs (log.info) and,
// for winners, to an alert ("Any alert() function call").
// NOTE: thresholds were calibrated on Polygon data; TradingView's FX tick volume
// is a different source, so the EUR/USD threshold may need tuning.
// Research tool, not trading advice.
// ════════════════════════════════════════════════════════════════════════════
indicator("Spike Alerts Log v1.00", shorttitle="SpikeLog", overlay=true, max_labels_count=500)

// ── inputs ──────────────────────────────────────────────────────────────────
qqqSym    = input.symbol("NASDAQ:QQQ", "QQQ symbol")
eurSym    = input.symbol("FX:EURUSD", "EUR/USD symbol")
qqqThr    = input.float(3.67, "QQQ spike: volume ≥ x × 20-day slot median", step=0.01)
eurThr    = input.float(1.83, "EUR/USD spike: volume ≥ x × 20-day slot median", step=0.01)
zThr      = input.float(2.0,  "Move size (sigma for that time slot)", step=0.1)
qqqHold   = input.int(2,  "QQQ signal hold (minutes)", minval=2, step=2)
eurHold   = input.int(60, "EUR/USD fade hold (minutes)", minval=2, step=2)
costUsd   = input.float(0.01, "Cost per round trip ($ per share)", step=0.005)
otherQ    = input.string("Off", "QQQ signal on untested tickers", options=["Off", "Same as QQQ", "Opposite QQQ"])
otherE    = input.string("Fade (opposite EUR)", "EUR signal on untested tickers", options=["Off", "Fade (opposite EUR)", "Same as EUR"])
onlyWin   = input.bool(true, "Table: show only positive trades")
nRows     = input.int(15, "Table rows", minval=1, maxval=40)
tblPos    = input.string("top_right", "Table position", options=["top_right", "bottom_right", "top_left", "bottom_left"])

// ── time / session ──────────────────────────────────────────────────────────
tz     = "America/New_York"
mins   = hour(time, tz) * 60 + minute(time, tz)
dow    = dayofweek(time, tz)
inRTH  = mins >= 570 and mins <= 958 and mins % 2 == 0 and dow != dayofweek.saturday and dow != dayofweek.sunday
slot   = inRTH ? int((mins - 570) / 2) : -1
dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)

// std of 2-min log returns per ET slot (09:30 … 15:58), 2-yr Polygon data
var array<float> QSIG = array.from(float(na), 1.3048e-03, 1.1350e-03, 1.1677e-03, 1.1985e-03, 1.1298e-03, 1.1123e-03, 1.0624e-03, 1.1467e-03, 1.0241e-03, 1.1058e-03, 1.0034e-03, 9.4231e-04, 1.0058e-03, 8.3885e-04, 1.3156e-03, 9.6429e-04, 8.9971e-04, 9.7126e-04, 8.5967e-04, 1.4836e-03, 1.3253e-03, 7.9460e-04, 1.0307e-03, 1.1541e-03, 9.8928e-04, 1.1413e-03, 8.4992e-04, 8.5398e-04, 9.0036e-04, 9.2985e-04, 8.4386e-04, 1.0308e-03, 8.9628e-04, 7.8010e-04, 7.3087e-04, 8.5586e-04, 7.9477e-04, 8.4081e-04, 7.7652e-04, 8.9708e-04, 8.1050e-04, 7.7071e-04, 7.6422e-04, 7.2592e-04, 8.0813e-04, 6.7017e-04, 8.1447e-04, 7.5485e-04, 6.8545e-04, 7.2861e-04, 6.4112e-04, 1.1065e-03, 6.5426e-04, 6.2924e-04, 7.0189e-04, 7.3046e-04, 6.7592e-04, 6.5693e-04, 6.4687e-04, 7.0281e-04, 5.9775e-04, 6.0932e-04, 6.8840e-04, 6.4083e-04, 7.4779e-04, 5.7431e-04, 5.8805e-04, 6.6285e-04, 5.9072e-04, 7.0612e-04, 6.4399e-04, 6.8178e-04, 6.6907e-04, 5.9300e-04, 6.8135e-04, 5.7290e-04, 5.4475e-04, 5.6356e-04, 5.5263e-04, 6.1635e-04, 5.8649e-04, 5.9349e-04, 6.2920e-04, 4.9973e-04, 6.2829e-04, 5.9395e-04, 6.2123e-04, 5.8627e-04, 5.3876e-04, 7.3031e-04, 5.5476e-04, 5.4051e-04, 6.2410e-04, 6.6766e-04, 6.3784e-04, 5.5763e-04, 5.7830e-04, 5.6594e-04, 5.8080e-04, 5.8277e-04, 5.4993e-04, 5.1033e-04, 5.6556e-04, 5.5461e-04, 8.1978e-04, 7.3652e-04, 5.8346e-04, 6.1760e-04, 5.5942e-04, 6.1072e-04, 5.6941e-04, 5.5213e-04, 5.5119e-04, 1.0364e-03, 7.0745e-04, 7.4627e-04, 6.7612e-04, 6.9636e-04, 1.0603e-03, 8.4127e-04, 6.0734e-04, 6.9695e-04, 6.4456e-04, 7.3614e-04, 5.5530e-04, 5.8602e-04, 5.1396e-04, 6.4995e-04, 5.3328e-04, 5.1759e-04, 4.9781e-04, 5.4279e-04, 5.9456e-04, 4.6194e-04, 7.3157e-04, 6.3390e-04, 6.6904e-04, 6.1838e-04, 5.7440e-04, 5.0157e-04, 4.4981e-04, 5.3856e-04, 5.0680e-04, 5.4094e-04, 5.6125e-04, 5.4230e-04, 4.7767e-04, 5.3629e-04, 4.9951e-04, 6.5810e-04, 5.1720e-04, 5.6330e-04, 5.4746e-04, 4.8455e-04, 5.2200e-04, 5.7204e-04, 5.5431e-04, 5.3142e-04, 4.6984e-04, 5.0820e-04, 5.4016e-04, 5.7462e-04, 5.7100e-04, 4.9537e-04, 7.3598e-04, 5.6412e-04, 5.0519e-04, 6.0049e-04, 5.2627e-04, 5.3536e-04, 5.5922e-04, 5.3813e-04, 5.6756e-04, 5.3421e-04, 6.1488e-04, 5.0378e-04, 5.2472e-04, 4.4564e-04, 5.3585e-04, 6.7355e-04, 6.0524e-04, 5.6414e-04, 6.5158e-04, 5.6900e-04, 6.7865e-04, 5.6737e-04, 5.6915e-04, 5.5645e-04, 4.9946e-04, 1.1436e-03, 5.9729e-04, 8.7754e-04, 5.3297e-04, 7.6125e-04)
var array<float> ESIG = array.from(float(na), 2.3757e-04, 2.4600e-04, 2.5692e-04, 2.8507e-04, 2.7260e-04, 2.3017e-04, 2.7504e-04, 2.9254e-04, 2.4948e-04, 2.5704e-04, 2.4153e-04, 2.3013e-04, 2.1775e-04, 2.1505e-04, 5.0072e-04, 3.2542e-04, 2.8656e-04, 3.0154e-04, 2.6536e-04, 2.7824e-04, 2.6475e-04, 2.6762e-04, 2.5845e-04, 2.2308e-04, 2.4550e-04, 2.6971e-04, 2.7204e-04, 2.5264e-04, 1.9906e-04, 2.4221e-04, 2.4824e-04, 2.3441e-04, 2.4699e-04, 2.2161e-04, 2.3293e-04, 2.4405e-04, 2.2817e-04, 2.4766e-04, 2.8744e-04, 3.0860e-04, 3.2035e-04, 2.7007e-04, 2.6708e-04, 2.0719e-04, 1.9919e-04, 3.2070e-04, 2.5156e-04, 2.4173e-04, 2.0362e-04, 2.4364e-04, 2.1017e-04, 2.4235e-04, 3.1312e-04, 2.1678e-04, 2.2953e-04, 2.4435e-04, 2.1750e-04, 1.9543e-04, 2.0046e-04, 2.3547e-04, 2.1369e-04, 1.9904e-04, 2.0130e-04, 1.9436e-04, 1.9245e-04, 1.9684e-04, 1.9349e-04, 1.9618e-04, 1.8456e-04, 2.1898e-04, 1.8833e-04, 3.0106e-04, 2.1162e-04, 1.7300e-04, 2.0528e-04, 2.0170e-04, 2.1442e-04, 1.9505e-04, 1.9902e-04, 1.8421e-04, 1.8476e-04, 1.8235e-04, 1.9977e-04, 1.8580e-04, 1.9587e-04, 1.8224e-04, 1.8234e-04, 1.5199e-04, 1.6376e-04, 1.7688e-04, 1.8433e-04, 1.7305e-04, 1.6238e-04, 1.7798e-04, 2.1918e-04, 1.6685e-04, 1.5819e-04, 1.7216e-04, 1.4608e-04, 1.5758e-04, 1.6171e-04, 1.6065e-04, 1.6031e-04, 1.4290e-04, 1.6287e-04, 1.9436e-04, 1.7149e-04, 1.7843e-04, 1.6537e-04, 1.7009e-04, 1.4924e-04, 1.7027e-04, 1.5702e-04, 1.9275e-04, 1.7781e-04, 2.1857e-04, 2.3978e-04, 1.3687e-04, 1.7408e-04, 1.7710e-04, 1.8690e-04, 1.6513e-04, 1.7158e-04, 1.5148e-04, 2.2907e-04, 1.6481e-04, 1.5488e-04, 1.5842e-04, 1.3643e-04, 1.5566e-04, 1.4889e-04, 1.6669e-04, 1.6350e-04, 1.4273e-04, 3.5462e-04, 1.8239e-04, 1.8854e-04, 2.1200e-04, 1.7017e-04, 1.6381e-04, 1.4711e-04, 1.4974e-04, 1.5324e-04, 1.4373e-04, 1.4056e-04, 1.5847e-04, 1.5678e-04, 1.4500e-04, 1.1633e-04, 1.4957e-04, 1.6573e-04, 2.0233e-04, 1.8043e-04, 1.9668e-04, 2.0234e-04, 1.7070e-04, 1.6566e-04, 1.4442e-04, 1.6277e-04, 1.7181e-04, 1.7291e-04, 1.7044e-04, 1.6337e-04, 1.4720e-04, 1.9473e-04, 1.5879e-04, 1.7662e-04, 1.4091e-04, 1.4416e-04, 1.5285e-04, 1.5535e-04, 1.5321e-04, 1.4713e-04, 1.6234e-04, 1.5748e-04, 1.3079e-04, 1.1678e-04, 1.1920e-04, 1.0689e-04, 1.5094e-04, 1.1956e-04, 1.3299e-04, 1.4953e-04, 1.6154e-04, 1.3681e-04, 1.2097e-04, 1.6374e-04, 1.7619e-04, 1.2585e-04, 1.3623e-04, 1.5238e-04, 1.5316e-04, 1.5000e-04, 1.3172e-04)

// ── leader data (same timeframe, no lookahead) ──────────────────────────────
[qC, qV] = request.security(qqqSym, timeframe.period, [close, volume], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
[eC, eV] = request.security(eurSym, timeframe.period, [close, volume], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)

// ── spike detector (one state per call site) ────────────────────────────────
// rvOnlyHistory = true  → "no high-volume bar in the previous 10 min" (QQQ rule)
// rvOnlyHistory = false → "no other spike in the previous 10 min" (EUR rule)
spikeDetect(float c, float v, float thr, array<float> sig, bool rvOnlyHistory) =>
    var matrix<float> hist = matrix.new<float>(195, 20, na)
    var float lastC = na
    var int lastDay = na
    var array<bool> recent = array.new<bool>()
    bool isSpike = false
    int dir = 0
    float rv = na
    float bps = na
    if dayKey != lastDay
        lastC := na
        array.clear(recent)
        lastDay := dayKey
    if slot >= 0
        if not na(c) and not na(v)
            float[] rowv = matrix.row(hist, slot)
            float[] clean = array.new<float>()
            for x in rowv
                if not na(x)
                    array.push(clean, x)
            float med = array.size(clean) >= 10 ? array.median(clean) : na
            rv := not na(med) and med > 0 ? v / med : na
            float r = not na(lastC) and mins > 570 ? math.log(c / lastC) : na
            float s = array.get(sig, slot)
            float z = not na(r) and not na(s) and s > 0 ? r / s : na
            bool hit = not na(rv) and rv >= thr and not na(z) and math.abs(z) >= zThr
            bool rec = false
            int n = array.size(recent)
            if n > 0
                for k = math.max(0, n - 5) to n - 1
                    if array.get(recent, k)
                        rec := true
            if hit and not rec
                isSpike := true
                dir := z > 0 ? 1 : -1
                bps := r * 1e4
            array.push(recent, rvOnlyHistory ? (not na(rv) and rv >= thr) : hit)
            for j = 0 to 18
                matrix.set(hist, slot, j, matrix.get(hist, slot, j + 1))
            matrix.set(hist, slot, 19, v)
            lastC := c
        else
            array.push(recent, false)
    [isSpike, dir, rv, bps]

[qSpike, qDir, qRv, qBps] = spikeDetect(qC, qV, qqqThr, QSIG, true)
[eSpike, eDir, eRv, eBps] = spikeDetect(eC, eV, eurThr, ESIG, false)

// ── trade direction for the chart ticker ────────────────────────────────────
tk = syminfo.ticker
int qSide = tk == "SOXL" ? 1 : tk == "VIXY" ? -1 : otherQ == "Same as QQQ" ? 1 : otherQ == "Opposite QQQ" ? -1 : 0
int eSide = tk == "VIXY" ? 1 : (tk == "SPY" or tk == "QQQ" or tk == "SOXL") ? -1 : otherE == "Fade (opposite EUR)" ? -1 : otherE == "Same as EUR" ? 1 : 0

// ── log storage ─────────────────────────────────────────────────────────────
var array<int>    lgT   = array.new<int>()
var array<string> lgSig = array.new<string>()
var array<int>    lgDir = array.new<int>()
var array<float>  lgEn  = array.new<float>()
var array<float>  lgEx  = array.new<float>()
var array<float>  lgPnl = array.new<float>()
var array<string> lgInfo = array.new<string>()

closeTrade(string sig, int t0, int d, float en, float ex, string info) =>
    float pnl = d * math.log(ex / en) * 1e4 - costUsd / en * 1e4
    array.push(lgT, t0)
    array.push(lgSig, sig)
    array.push(lgDir, d)
    array.push(lgEn, en)
    array.push(lgEx, ex)
    array.push(lgPnl, pnl)
    array.push(lgInfo, info)
    string msg = str.format("{0} {1} {2} {3} @ {4} → {5}  ({6} bps)  [{7}]", sig, str.format_time(t0, "MM-dd HH:mm", tz), d > 0 ? "LONG" : "SHORT", tk, str.tostring(en, format.mintick), str.tostring(ex, format.mintick), str.tostring(pnl, "#.0"), info)
    log.info(msg)
    if pnl > 0
        alert("✅ POSITIVE · " + msg, alert.freq_once_per_bar_close)
    pnl

// open trades
var float qEn = na
var int   qT  = na
var int   qD  = 0
var float eEn = na
var int   eT  = na
var int   eD  = 0
var string qInfo = ""
var string eInfo = ""

// 1) exits first (exit at this bar's close)
if not na(qEn) and (time - qT >= qqqHold * 60000 or dayKey != dayKey[1])
    closeTrade("QQQ spike", qT, qD, qEn, close, qInfo)
    qEn := na
if not na(eEn) and (time - eT >= eurHold * 60000 or mins == 958)
    closeTrade("EUR fade", eT, eD, eEn, close, eInfo)
    eEn := na

// 2) entries at the spike bar's close
if qSpike and inRTH and qSide != 0 and na(qEn) and mins < 958
    qEn := close
    qT := time
    qD := qSide * qDir
    qInfo := str.format("QQQ {0} bps, vol {1}x", str.tostring(qBps, "#.0"), str.tostring(qRv, "#.0"))
    alert(str.format("QQQ volume spike → {0} {1} @ {2} for {3} min ({4})", qD > 0 ? "LONG" : "SHORT", tk, str.tostring(close, format.mintick), qqqHold, qInfo), alert.freq_once_per_bar_close)
if eSpike and inRTH and eSide != 0 and na(eEn) and mins < 958
    eEn := close
    eT := time
    eD := eSide * eDir
    eInfo := str.format("EUR {0} bps, vol {1}x", str.tostring(eBps, "#.0"), str.tostring(eRv, "#.0"))
    alert(str.format("EUR/USD volume spike → {0} {1} @ {2} for {3} min ({4})", eD > 0 ? "LONG" : "SHORT", tk, str.tostring(close, format.mintick), eurHold, eInfo), alert.freq_once_per_bar_close)

// ── chart marks ─────────────────────────────────────────────────────────────
plotshape(qSpike and inRTH, "QQQ spike", shape.diamond, location.abovebar, color.new(color.aqua, 0), size = size.tiny)
plotshape(eSpike and inRTH and eDir > 0, "EUR spike up", shape.triangledown, location.abovebar, color.new(color.purple, 0), size = size.small)
plotshape(eSpike and inRTH and eDir < 0, "EUR spike down", shape.triangleup, location.belowbar, color.new(color.purple, 0), size = size.small)

// ── table ───────────────────────────────────────────────────────────────────
pos = tblPos == "top_right" ? position.top_right : tblPos == "bottom_right" ? position.bottom_right : tblPos == "top_left" ? position.top_left : position.bottom_left
var table tb = table.new(pos, 6, 44, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))

statLine(string sig) =>
    int n = 0
    int w = 0
    float s = 0.0
    for i = 0 to array.size(lgSig) - 1
        if array.get(lgSig, i) == sig
            n += 1
            float p = array.get(lgPnl, i)
            s += p
            if p > 0
                w += 1
    n == 0 ? sig + ": no trades yet" : str.format("{0}: {1} trades · {2}% positive · avg {3} bps", sig, n, str.tostring(100.0 * w / n, "#"), str.tostring(s / n, "#.0"))

if barstate.islast
    table.clear(tb, 0, 0, 5, 43)
    table.cell(tb, 0, 0, "Spike Alerts Log — " + tk + (timeframe.period != "2" ? "   ⚠ use a 2-minute chart" : ""), text_color = color.white, text_size = size.small)
    table.merge_cells(tb, 0, 0, 5, 0)
    nT = array.size(lgSig)
    table.cell(tb, 0, 1, nT > 0 ? statLine("QQQ spike") : "QQQ spike: no trades yet", text_color = color.aqua, text_size = size.tiny)
    table.merge_cells(tb, 0, 1, 5, 1)
    table.cell(tb, 0, 2, nT > 0 ? statLine("EUR fade") : "EUR fade: no trades yet", text_color = color.fuchsia, text_size = size.tiny)
    table.merge_cells(tb, 0, 2, 5, 2)
    hdr = array.from("Time (ET)", "Signal", "Side", "Entry", "Exit", "bps")
    for c = 0 to 5
        table.cell(tb, c, 3, array.get(hdr, c), text_color = color.silver, text_size = size.tiny)
    int r = 4
    if nT > 0
        for i = nT - 1 to 0
            if r >= 4 + nRows
                break
            float p = array.get(lgPnl, i)
            if onlyWin and p <= 0
                continue
            color tc = p > 0 ? color.lime : color.red
            table.cell(tb, 0, r, str.format_time(array.get(lgT, i), "MM-dd HH:mm", tz), text_color = color.white, text_size = size.tiny)
            table.cell(tb, 1, r, array.get(lgSig, i), text_color = array.get(lgSig, i) == "QQQ spike" ? color.aqua : color.fuchsia, text_size = size.tiny)
            table.cell(tb, 2, r, array.get(lgDir, i) > 0 ? "LONG" : "SHORT", text_color = color.white, text_size = size.tiny)
            table.cell(tb, 3, r, str.tostring(array.get(lgEn, i), format.mintick), text_color = color.white, text_size = size.tiny)
            table.cell(tb, 4, r, str.tostring(array.get(lgEx, i), format.mintick), text_color = color.white, text_size = size.tiny)
            table.cell(tb, 5, r, str.tostring(p, "#.0"), text_color = tc, text_size = size.tiny)
            r += 1
    // open trades
    if not na(qEn)
        table.cell(tb, 0, r, "OPEN QQQ spike " + (qD > 0 ? "LONG" : "SHORT") + " @ " + str.tostring(qEn, format.mintick), text_color = color.yellow, text_size = size.tiny)
        table.merge_cells(tb, 0, r, 5, r)
        r += 1
    if not na(eEn)
        table.cell(tb, 0, r, str.format("OPEN EUR fade {0} @ {1} · {2} min left", eD > 0 ? "LONG" : "SHORT", str.tostring(eEn, format.mintick), str.tostring(math.max(0, eurHold - (time - eT) / 60000), "#")), text_color = color.yellow, text_size = size.tiny)
        table.merge_cells(tb, 0, r, 5, r)
